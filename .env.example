# ==============================================================================
# LLM Code Analyzer & SAST/DAST Correlation Engine Environment Configuration
# ==============================================================================

# LLM Execution Mode: "groq" (Online Cloud Mode) or "ollama" (Offline Local Mode)
LLM_MODE=groq

# ------------------------------------------------------------------------------
# Groq Configuration (Online Mode)
# Get your free API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models:
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MODEL=mixtral-8x7b-32768

# ------------------------------------------------------------------------------
# Ollama Configuration (Offline Local Mode)
# Download Ollama at: https://ollama.ai
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# Analysis & Engine Settings
# ------------------------------------------------------------------------------
MAX_CODE_LENGTH=50000
ANALYSIS_TIMEOUT=120

# ------------------------------------------------------------------------------
# Rate Limiting Configuration (Optional)
# ------------------------------------------------------------------------------
RATE_LIMIT_ANALYSIS_PER_MINUTE=60
REDIS_URL=

# ------------------------------------------------------------------------------
# Datadog SAIST Integration (AI-Native SAST via Groq)
# ------------------------------------------------------------------------------
# Path to datadog-saist CLI binary (built via scripts/setup_datadog_saist.sh)
DATADOG_SAIST_BIN=./bin/datadog-saist
# Enable Datadog SAIST (uses Go binary if built, or native Python 2-stage engine)
ENABLE_DATADOG_SAIST=true
