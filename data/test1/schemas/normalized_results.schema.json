{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized SAST-DAST Correlation Results",
  "type": "object",
  "required": [
    "code_findings",
    "runtime_findings",
    "confirmed_issues",
    "reported_issues",
    "scan_seconds"
  ],
  "properties": {
    "code_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "line"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "cwe": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "runtime_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "parameter"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "cwe": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "confirmed_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sast",
          "dast"
        ],
        "properties": {
          "sast": {
            "type": "object",
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            }
          },
          "dast": {
            "type": "object",
            "required": [
              "method",
              "path",
              "parameter"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "parameter": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "reported_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "scan_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}