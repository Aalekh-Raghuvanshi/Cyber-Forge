FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_APP=app.py

WORKDIR /opt/benchmark

COPY data/benchmarkpython/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.txt

COPY data/benchmarkpython/ ./

EXPOSE 8443

CMD ["flask", "--app", "app.py", "run", "--host=0.0.0.0", "--port=8443", "--cert=adhoc"]
